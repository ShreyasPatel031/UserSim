# UserSim MVP — Cursor Cloud / runtime secrets
# Copy into Cloud Agent secrets (or `cp .env.cloud.example .env.local` and fill).
# Do NOT commit filled values.

# --- GCP / Vertex (required) ---
GCP_PROJECT=project-amer-scs-sandbox
GOOGLE_CLOUD_PROJECT=project-amer-scs-sandbox
GCLOUD_PROJECT=project-amer-scs-sandbox
CLOUDSDK_CORE_PROJECT=project-amer-scs-sandbox
VERTEX_LOCATION=us-central1
MVP_BROWSER_MODEL=gemini-2.5-flash
MVP_SIGNUP_MODEL=gemini-2.5-flash

# Prefer raw SA JSON (code reads this on serverless/cloud):
# VERTEX_ADC_JSON={"type":"service_account","project_id":"project-amer-scs-sandbox",...}
VERTEX_ADC_JSON=

# Or path if the runtime materializes a file for you:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Optional if you only have base64 today (not read by code yet — prefer VERTEX_ADC_JSON):
# GOOGLE_APPLICATION_CREDENTIALS_B64=

# --- GCS (defaults work; override if needed) ---
MVP_GCS_BUCKET=usersim-bakeoff-347838016394
MVP_GCS_PREFIX=gs://usersim-bakeoff-347838016394

# --- GCP fleet / warm seed (required for live local-style runs) ---
MVP_GCP_FLEET=1
MVP_GCP_USE_SEEDS=1
MVP_GCP_ALLOW_SPOT=0
MVP_GCP_SEED_WORKERS=1
MVP_GCP_TARGET_VM=usersim-youtube-seed-0
MVP_GCP_SEED_PREFIX=usersim-youtube-seed-
MVP_GCP_IMAGE_FAMILY=usersim-mvp-seed
MVP_GCP_WORKERS=8
MVP_GCP_FLEET_TIMEOUT_S=900
MVP_FORCE_LOCAL_BROWSER=0
MVP_CHROMIUM_NO_SANDBOX=1
MVP_BROWSER_HEADLESS=0
MVP_AUTO_SIGNIN=1

# Seed → cloud UI frame push (set to your public cloud URL when available)
# MVP_LIVE_PUSH_URL=https://YOUR_CLOUD_HOST/api/internal/live-frame
# MVP_PUBLIC_BASE_URL=https://YOUR_CLOUD_HOST

# --- Browserbase (needed if not using GCP warm Chromium) ---
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=a5c45437-53a8-472a-bed8-c6c06d8951ab
USE_BROWSERBASE=1
MVP_SIGNUP_BROWSERBASE=1
BROWSERBASE_CREATE_INTERVAL_S=8

# --- YouTube / Gmail auto-signin ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Study shape (match Vercel defaults) ---
MVP_MAX_STEPS=8
MVP_MAX_BROWSER_STEPS=8
MVP_BROWSER_CONCURRENCY=8
MVP_AGENT_COUNT=6
MVP_PERSONA_COUNT=5
MVP_TASK_COUNT=6
MVP_STUDY_TIMEOUT_S=240
MVP_AGENT_CONCURRENCY=24
MVP_CAPTCHA_ALLOW_HUMAN=1
MVP_CAPTCHA_SOLVER=0

# --- Optional SMS / ntfy captcha assist ---
# MVP_NTFY_BASE=
# MVP_NTFY_SMS_TOPIC=
# MVP_SMS_BACKEND=
