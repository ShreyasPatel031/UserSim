+          "votesCount", "commentsCount", "createdAt", "featuredAt", "website", "media", "reviewsCount", "reviewsRating"}
+
+
+def _person(x):
+    x = x or {}
+    return {"id": x.get("id"), "createdAt": x.get("createdAt"), "followersCount": x.get("followersCount"), "headline": x.get("headline"),
+            "websiteUrl": x.get("websiteUrl"), "has_twitter": bool(x.get("twitterUsername")),
+            **{k: v for k, v in x.items() if k not in HANDLE_KEYS | {"id", "createdAt", "followersCount", "headline", "websiteUrl"}}}
+
