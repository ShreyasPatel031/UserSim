# Environment for reproducing the e2e runs in mvp/E2E_HANDOFF.md
#
# Captured verbatim from the running local server (pid 17268) on 2026-09-08,
# with secrets removed. Copy to a local file, fill the REDACTED values from
# .env.local / secrets/sa.json, then:
#
#   set -a; . ./e2e.env; set +a
#   python -m uvicorn mvp.server:app --host 127.0.0.1 --port 3000
#
# DO NOT COMMIT a filled-in copy. Real keys live in .env.local (gitignored).

# ---- secrets: fill from .env.local / secrets/sa.json ----
BROWSERBASE_API_KEY=<REDACTED>
BROWSERBASE_PROJECT_ID=<REDACTED>
GOOGLE_APPLICATION_CREDENTIALS=<REDACTED — abs path to secrets/sa.json>
# Private ntfy topic (anyone holding it can push notifications) — fill locally.
MVP_NTFY_SMS_TOPIC=<REDACTED>

# ---- Browserbase ----
# NOTE: the account plan ceiling is 25 concurrent sessions, confirmed via
#   GET https://api.browserbase.com/v1/projects -> {"concurrency": 25}
# Running the full persona x site matrix in a single wave requires a plan
# upgrade. See E2E_HANDOFF.md.
USE_BROWSERBASE=1
BROWSERBASE_PROXIES=1
# As-captured from the local server. These are the values that made full
# studies look broken: a semaphore of 2 turns an 18-agent study into 9 waves.
BROWSERBASE_MAX_CONCURRENT=5
MVP_BROWSER_CONCURRENCY=2
# What the passing smoke runs actually used (override these for e2e):
#   BROWSERBASE_MAX_CONCURRENT=25
#   MVP_BROWSER_CONCURRENCY=8
BROWSERBASE_CREATE_INTERVAL_S=8

# ---- browser behaviour ----
MVP_BROWSER_HEADLESS=0
MVP_FORCE_LOCAL_BROWSER=0
MVP_CHROMIUM_NO_SANDBOX=1
MVP_SNAPSHOT_ONLY=0
MVP_VERCEL_BROWSER=1

# ---- models (Vertex) ----
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=project-amer-scs-sandbox
GOOGLE_CLOUD_LOCATION=us-central1
GCP_PROJECT=project-amer-scs-sandbox
VERTEX_LOCATION=us-central1
MVP_BROWSER_MODEL=gemini-2.5-flash-lite
MVP_SIGNUP_MODEL=gemini-2.5-flash-lite

# ---- GCP fleet ----
# The fleet branch is currently UNREACHABLE: _prefer_browserbase_live() returns
# _browserbase_configured(), which short-circuits
#   elif _fleet_preferred(...) and not _prefer_browserbase_live(study)
# in mvp/study.py. Intended (moving off the fleet) but it makes Browserbase
# concurrency the hard parallelism ceiling.
MVP_PREFER_GCP_FLEET=0
MVP_GCP_FLEET=1
MVP_GCP_USE_SEEDS=1
MVP_GCP_ALLOW_SPOT=0
MVP_GCP_WORKERS=8

# ---- auth / captcha / signup ----
MVP_AUTO_SIGNIN=1
MVP_SIGNUP_BROWSERBASE=1
MVP_CAPTCHA_SOLVER=0
MVP_CAPTCHA_ALLOW_HUMAN=0
MVP_CAPTCHA_HUMAN_TIMEOUT_S=240

# ---- notifications ----
MVP_SMS_BACKEND=ntfy
MVP_NTFY_BASE=https://ntfy.sh

# ---- judge model for the e2e harness (optional) ----
# E2E_JUDGE_MODEL=gemini-2.5-flash-lite
