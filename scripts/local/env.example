# Copy to secrets/env and fill in values:
#   mkdir -p secrets && cp scripts/local/env.example secrets/env
#
# Load before running:
#   set -a && source secrets/env && set +a

GCP_PROJECT=project-amer-scs-sandbox
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex_adc.json

# Hugging Face (model downloads)
HF_TOKEN=

# Gemini agent + judge use Vertex ADC (GOOGLE_APPLICATION_CREDENTIALS above).
# Or set GEMINI_API_KEY if not using Vertex.

# Browserbase (optional — free tier works for some sites)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# USE_BROWSERBASE=1          # route Browser Use via Browserbase CDP
# BROWSERBASE_PROXIES=1      # paid plan — residential proxies
