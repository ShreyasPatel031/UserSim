# Copy for local/VM:
#   mkdir -p secrets && cp scripts/local/env.example secrets/env
#   set -a && source secrets/env && set +a
#
# For Cloud Agents (always available across runs): do NOT rely on this file
# (secrets/ is gitignored). Add the same keys in:
#   https://cursor.com/dashboard/cloud-agents  → Secrets
# Prefer Runtime Secret for passwords / API keys / SA B64.

# --- Gmail IMAP (signup codes) — Google App Password, not account password ---
GMAIL_USER=your.name@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- GCP / Vertex (fill from Cursor Secrets / your SA) ---
GCP_PROJECT=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
CLOUDSDK_CORE_PROJECT=
GOOGLE_CLOUD_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex_adc.json
# Cloud Agents usually inject this instead of a file:
# GOOGLE_APPLICATION_CREDENTIALS_B64=

# --- Signup agent ---
MVP_SIGNUP_MODEL=gemini-2.5-flash
MVP_BROWSER_MODEL=gemini-2.5-flash
MVP_BROWSER_HEADLESS=0
MVP_CAPTCHA_SOLVER=0
MVP_CAPTCHA_ALLOW_HUMAN=0
# MVP_CAPTCHA_SOLVER=1
# MVP_CAPTCHA_API=capsolver
# MVP_CAPTCHA_API_KEY=

# --- Phone / SMS verification ---
# Backend is auto-selected: "messages" on macOS (reads the Messages DB), "ntfy"
# elsewhere. A seed VM has no Messages DB, so it uses ntfy: the handset forwards
# incoming SMS to a topic and the agent polls it. No Mac in the path.
#   Set up the phone rule:  python scripts/local/sms_relay_check.py --setup
#   Confirm it works:       python scripts/local/sms_relay_check.py
# MVP_SMS_BACKEND=ntfy
# MVP_NTFY_SMS_TOPIC=        # defaults to "<push.ntfy_topic>-sms" from the vault
# MVP_NTFY_BASE=https://ntfy.sh
# Real verification codes cross this topic. On public ntfy.sh the topic name is
# the only secret — prefer a reserved topic with a token, or self-host.
# MVP_NTFY_TOKEN=            # or push.ntfy_token in secrets/credentials.json
#
# Disposable numbers, for products that have burned the real one:
# MVP_SMS_BACKEND=api
# MVP_SMS_API=sms-activate
# MVP_SMS_API_KEY=

# --- Server admin (required on the VM; see deploy/README.md) ---
# Bearer token for /api/runtime/kill and admin_dogfood studies. Without it the
# server refuses every admin call. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
USERSIM_ADMIN_TOKEN=
# Extra UserSim hosts/IPs that agents must never drive (comma-separated).
# USERSIM_OWN_HOSTS=
# USERSIM_OWN_IPS=
# USERSIM_AGENT_DENY_IPS=
# Study start caps (defaults shown).
# MVP_MAX_STUDY_STARTS=6
# MVP_STUDY_START_WINDOW_S=600
# MVP_MAX_CONCURRENT_STUDIES=2
# MVP_ADMITTED_MAX_AGE_S=1800

# --- Optional ---
HF_TOKEN=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
