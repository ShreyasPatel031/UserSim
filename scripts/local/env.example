# Copy for local/VM:
#   mkdir -p secrets && cp scripts/local/env.example secrets/env
#   set -a && source secrets/env && set +a
#
# For Cloud Agents (always available across runs): do NOT rely on this file
# (secrets/ is gitignored). Add the same keys in:
#   https://cursor.com/dashboard/cloud-agents  → Secrets
# Prefer Runtime Secret for passwords / API keys / SA B64.

# --- Gmail IMAP (signup codes) — Google App Password, not account password ---
GMAIL_USER=your.name@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- GCP / Vertex (fill from Cursor Secrets / your SA) ---
GCP_PROJECT=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
CLOUDSDK_CORE_PROJECT=
GOOGLE_CLOUD_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex_adc.json
# Cloud Agents usually inject this instead of a file:
# GOOGLE_APPLICATION_CREDENTIALS_B64=

# --- Signup agent ---
MVP_SIGNUP_MODEL=gemini-2.5-flash
MVP_BROWSER_MODEL=gemini-2.5-flash
MVP_BROWSER_HEADLESS=0
MVP_CAPTCHA_SOLVER=0
MVP_CAPTCHA_ALLOW_HUMAN=0
# MVP_CAPTCHA_SOLVER=1
# MVP_CAPTCHA_API=capsolver
# MVP_CAPTCHA_API_KEY=

# --- Optional ---
HF_TOKEN=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
