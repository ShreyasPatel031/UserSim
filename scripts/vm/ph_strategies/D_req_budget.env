# Strategy D — fixed req/min budget (tabs as workers, rate is the guardrail)
# High tab ceiling but hard token bucket; optimize people/req not tab count.
# Ref: dual limiter semaphore + token bucket (Scraping Central, ProxyHat)
PH_STRATEGY=req_budget
PH_MAX_INFLIGHT_TABS=48
PH_REQ_PER_MIN_CAP=140
PH_REQ_PER_MIN_FLOOR=50
PH_INTER_REQ_MS_MIN=100
PH_INTER_REQ_MS_JITTER=350
PH_SKIP_REDUNDANT_CURSOR=1
PH_LAZY_TABS=1
PH_SERIALIZE_HOT_STACKS=0
PH_CIRCUIT_COOLDOWN_SEC=600
