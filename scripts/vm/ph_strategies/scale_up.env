# Scale-up: start low, climb to 32 parallel; stop entire run on first 403.
# Ramp tiers advance after ~40 clean reqs each (ph_person.Runner.maybe_ramp).
PH_STRATEGY=scale_up
PH_TABS=32
PH_BROWSER_TABS=32
PH_MAX_INFLIGHT_TABS=32
PH_RAMP=4:40,8:80,16:120,24:140,32:160
PH_REQ_PER_MIN_CAP=160
PH_PERSON_INTERVAL=0
PH_STOP_ON_FIRST_BLOCK=1
PH_PORTSCREEN_HOME_ONLY=1
