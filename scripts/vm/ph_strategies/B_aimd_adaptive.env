# Strategy B — AIMD adaptive (maximize people/min over 4h)
# Climb tabs + req/min while clean; multiplicative drop on 403/429.
# Ref: AIMD (Crawlex), adaptive concurrency (Novada)
PH_STRATEGY=aimd_adaptive
PH_MAX_INFLIGHT_TABS=64
PH_START_INFLIGHT_TABS=4
PH_REQ_PER_MIN_CAP=150
PH_START_REQ_PER_MIN=45
PH_INTER_REQ_MS_MIN=200
PH_INTER_REQ_MS_JITTER=400
PH_AIMD_ADD_TABS=1
PH_AIMD_ADD_RPM=8
PH_AIMD_DECAY_ON_403=0.5
PH_AIMD_DECAY_ON_429=0.7
PH_PROFILES_CLEAN_BEFORE_RAISE=2
PH_LAZY_TABS=1
PH_CIRCUIT_COOLDOWN_SEC=600
