# Strategy C — burst/coast duty cycle (sustained extraction)
# Short high parallelism windows, mandatory low-rate coast — avoids edge sitting.
# Ref: controlled fan-out + queue shaping (Novada)
PH_STRATEGY=burst_coast
PH_MAX_INFLIGHT_TABS=32
PH_BURST_INFLIGHT_TABS=24
PH_BURST_SEC=90
PH_COAST_SEC=75
PH_COAST_REQ_PER_MIN=25
PH_BURST_REQ_PER_MIN=130
PH_INTER_REQ_MS_MIN=150
PH_INTER_REQ_MS_JITTER=500
PH_LAZY_TABS=1
PH_CIRCUIT_COOLDOWN_SEC=1200
