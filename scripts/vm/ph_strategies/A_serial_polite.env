# Strategy A — serial polite (longevity / min blocks)
# One browser, tight dual limiter: low in-flight + low start rate.
# Ref: token bucket + session budget (Proxora, Crawlex AIMD)
PH_STRATEGY=serial_polite
PH_MAX_INFLIGHT_TABS=4
PH_REQ_PER_MIN_CAP=36
PH_INTER_REQ_MS_MIN=800
PH_INTER_REQ_MS_JITTER=600
PH_AIMD_ADD_TABS=0
PH_AIMD_ADD_RPM=5
PH_AIMD_DECAY_ON_403=0.5
PH_COAST_SEC_PER_PROFILE=15
PH_LAZY_TABS=1
PH_CIRCUIT_COOLDOWN_SEC=900
