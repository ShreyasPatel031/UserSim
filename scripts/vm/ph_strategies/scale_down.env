# Scale-down: start at 32 parallel, step down the ramp list while clean.
# maybe_ramp advances tier index; tiers are ordered high→low so "climb" = scale down.
# Stop entire run on first 403.
PH_STRATEGY=scale_down
PH_TABS=32
PH_BROWSER_TABS=32
PH_MAX_INFLIGHT_TABS=32
PH_RAMP=32:160,24:140,16:100,8:60,4:40
PH_REQ_PER_MIN_CAP=160
PH_PERSON_INTERVAL=0
PH_STOP_ON_FIRST_BLOCK=1
PH_PORTSCREEN_HOME_ONLY=1
