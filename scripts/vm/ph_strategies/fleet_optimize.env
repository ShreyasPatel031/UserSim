# Fleet: full18e pdeep FULL mode (Population whole-person gate), per-VM queue stride, fast CF fail-over to a free port.
# Ops authority: fleet operator only (not Population). Set 1 only on explicit operator pause.
PH_FLEET_BLOCK_PAUSE=0
# No fleet-side byte cap: proxy spend is limited at the provider account.
PEOPLE_CAP_BYTES=1e18
PH_STRATEGY=scale_down
PH_TABS=16
PH_BROWSER_TABS=16
PH_MAX_INFLIGHT_TABS=16
PH_RAMP=16:80,12:60,8:40,4:30
PH_REQ_PER_MIN_CAP=80
PH_PERSON_INTERVAL=0
PH_STOP_ON_FIRST_BLOCK=0
PH_BLOCK_CIRCUIT=8
PH_BLOCK_ROTATE_SLEEP_SEC=20
PH_BLOCK_SAME_PORT_RETRIES=2
PH_BLOCK_SAME_PORT_SLEEP_SEC=20
PH_PORTSCREEN_HOME_ONLY=1
PH_PORTSCREEN_MAX_TRY_ON_BLOCK=24
PH_PORTSCREEN_SKIP_REGISTERED=1
PH_MEM_MB=7500
PH_RECYCLE_EVERY=250
PH_REQUIRE_FULL_SAVE=1
PH_MIN_HEADER_PCT=98
PH_MIN_TAB_PCT=95
PDEEP_MODE=full
PDEEP_K=4
PDEEP_TABS=2
PH_SAVE_B_SUFFIX=_pacetest/shared
PH_FLEET_N=32
PH_FLEET_RR_ONLY=1
# Population 09:24Z orchestrator queue order (full18f, same-IP only).
PH_RR_FILES=rerun_whole_20261110T0945Z_lastweek_votes.txt,fix_vmgate_repull.txt,fix_full18e_follow.txt,fix_signedin_or_maker.txt,rerun_whole_20261110T0355Z_full18f_rule.txt,rerun_whole_20261110T0930Z_voternet_1_60k.txt,rerun_whole_20261110T0245Z_overnight.txt
PH_BLOCK_NEW_PORT=0
PH_BLOCK_SAME_PORT_RETRIES=6
PH_BLOCK_REST_SEC=10
PH_CF_BACKOFF_SEC=20
PH_CF_FLEET_REST_SEC=120
PH_CF_MAX_BLOCKS=1
PDEEP_QUEUE_CACHE_SEC=3600
PH_CF_OPEN_SEC=75
# pdeep queue build can exceed 10m on cache miss — avoid mass BATCH_KICK during check-in.
CF_WALL_MAX_SEC=1800
FLEET_CF_RECOVER_MAX_KICKS=2
