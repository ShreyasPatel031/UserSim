# Fleet: full18e pdeep FULL mode (Population whole-person gate), per-VM queue stride, fast CF fail-over to a free port.
# Ops authority: fleet operator only (not Population). Set 1 only on explicit operator pause.
PH_FLEET_BLOCK_PAUSE=0
# No fleet-side byte cap: proxy spend is limited at the provider account.
PEOPLE_CAP_BYTES=1e18
PH_STRATEGY=scale_down
PH_TABS=16
PH_BROWSER_TABS=16
PH_MAX_INFLIGHT_TABS=16
PH_RAMP=16:80,12:60,8:40,4:30
PH_REQ_PER_MIN_CAP=80
PH_PERSON_INTERVAL=0
PH_PERSON_BUDGET_SEC=1080
NO_PROGRESS_SECS=300
PH_TAB_STALL_SECS=300
PH_STOP_ON_FIRST_BLOCK=0
PH_BLOCK_CIRCUIT=8
PH_BLOCK_ROTATE_SLEEP_SEC=20
PH_BLOCK_SAME_PORT_RETRIES=2
PH_BLOCK_SAME_PORT_SLEEP_SEC=20
PH_PORTSCREEN_HOME_ONLY=1
PH_PORTSCREEN_MAX_TRY_ON_BLOCK=24
PH_PORTSCREEN_SKIP_REGISTERED=1
PH_MEM_MB=7500
PH_RECYCLE_EVERY=250
PH_REQUIRE_FULL_SAVE=1
PH_MIN_HEADER_PCT=98
PH_MIN_TAB_PCT=95
PDEEP_MODE=full
PDEEP_K=4
PDEEP_TABS=2
PH_SAVE_B_SUFFIX=_pacetest/shared
PH_FLEET_N=32
# 16:35Z orchestrator: drain completion_queue only (no rerun_whole / need_list complete re-pulls).
PH_FLEET_RR_ONLY=1
# Set by ph_fleet_repoint_completion_queue.sh after building filtered fix_* on GCS.
PH_RR_FILES=fix_completion_queue_20261118T0636Z.txt
# Dedicated static IPs have no other port: a hard CF 403 takes the escalating same-IP cooldown
# (see PH_CF_FLEET_REST_SEC below) instead of relaunching every ~minute and keeping the IP flagged.
PH_BLOCK_NEW_PORT=0
# Every IP is bound to a VM, so a rotate request can never be served: back off on the same IP instead.
PH_IPROYAL_ROTATE_ON_BLOCK=0
PH_IPROYAL_ROTATE_ON_RECREATE=0
PH_BLOCK_SAME_PORT_RETRIES=6
PH_BLOCK_REST_SEC=10
PH_CF_BACKOFF_SEC=20
# Same-IP CF backoff: 2 min, doubling per consecutive short run, cap 2 h, then half workers. A 10 min first rest
# idled 8 of 17 slots at once in a CF wave (04:00Z), so the first rest stays short; a run of >= 15 min resets the count.
PH_CF_FLEET_REST_SEC=120
PH_CF_RESET_AFTER_SEC=900
PH_CF_COOLDOWN_MAX_SEC=7200
PH_CF_HALVE_AT_N=5
PH_CF_MAX_BLOCKS=1
PDEEP_QUEUE_CACHE_SEC=3600
PDEEP_HAVE_REFRESH_SEC=900
PH_CF_OPEN_SEC=75
# pdeep queue build can exceed 10m on cache miss — avoid mass BATCH_KICK during check-in.
CF_WALL_MAX_SEC=1800
FLEET_CF_RECOVER_MAX_KICKS=2
