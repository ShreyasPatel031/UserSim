# Daily browser jobs (people page1 + launch-page heavy pass): steady, below L3.
# Measured on Spain ISP: L2_modest ok (mean 1.0 complete/min); daily light pulls use lower GQL volume.
PH_STRATEGY=scale_down
PH_TABS=8
PH_BROWSER_TABS=8
PH_MAX_INFLIGHT_TABS=8
PH_RAMP=8:50,6:40,4:30
PH_REQ_PER_MIN_CAP=50
PDEEP_K=4
PDEEP_TABS=2
PDEEP_RAMP=8:50
PH_CF_FLEET_REST_SEC=600
PH_BLOCK_CIRCUIT=4
