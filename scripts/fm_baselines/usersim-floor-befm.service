[Unit]
Description=Qwen3-8B-Base BehaviorBench floor (vLLM + eval)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shreyaspatel
WorkingDirectory=/opt/usersim_fm
Environment=FLOOR_MODEL=Qwen/Qwen3-8B-Base
Environment=ROOT=/opt/usersim_fm
Environment=CONCURRENCY=32
Environment=MAX_NUM_SEQS=64
Environment=MAX_TOKENS=64
Environment=WORKFLOW_MAX_TOKENS=512
Environment=MODE=full
Environment=WATCHDOG_ARMED=1
Environment=HOME=/home/shreyaspatel
Environment=SKIP_INSTALL=0
Environment=VLLM_ENGINE_READY_TIMEOUT_S=600
Environment=VLLM_ENGINE_ITERATION_TIMEOUT_S=300
Environment=VLLM_WORKER_MULTIPROC_METHOD=spawn
ExecStartPre=/bin/bash -lc 'pkill -f qwen_openai_server.py || true'
ExecStart=/bin/bash /opt/usersim_fm/scripts/run_qwen_befm_full.sh
Restart=on-failure
RestartSec=20
StandardOutput=append:/opt/usersim_fm/results/qwen_befm_full.log
StandardError=append:/opt/usersim_fm/results/qwen_befm_full.log
KillMode=control-group

[Install]
WantedBy=multi-user.target
