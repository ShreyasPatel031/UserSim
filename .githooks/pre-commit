#!/bin/sh
# Blocks commits that reach a proxy or Apify outside the fetch gateway (src/fetchgate/). Enable once per clone:
#   git config core.hooksPath .githooks
files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
# shellcheck disable=SC2086
PYTHONPATH=src exec python3 -m fetchgate scan --staged $files
