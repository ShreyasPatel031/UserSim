+# 2) thread features at 00:05 PT from the 00:05 comment read (NEW input: data/today_comments/<day>.jsonl, every comment and
+# reply of today's posts with created_at, parent_id, commenter_user_id; hunter = today JSON post.user.id). Missing hunter ->
+# day mean; no comment read -> the clean score alone (logged).
+def thread_feats(day, te):
+    p = f"data/today_comments/{day}.jsonl"
+    if not os.path.exists(p):
+        return None
+    C = pd.DataFrame([json.loads(l) for l in open(p)]); C["ts"] = pd.to_datetime(C.created_at, utc=True)
